# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local).
# Leave unset in development to fall back to an in-memory database (dev dependency).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/business-nexus

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Email (optional - OTP/reset emails are logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Business Nexus <no-reply@nexus.local>
